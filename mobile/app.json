{
  "expo": {
    "name": "Open House Realty",
    "slug": "open-house-realty",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/openhouse-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#003A8C",
        "foregroundImage": "./assets/openhouse-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/openhouse-app-icon.png"
    },
    "scheme": "openhouse-realty",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
